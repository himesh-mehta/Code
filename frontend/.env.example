# YouTube Data API v3 (Required for video search and public metadata)
YOUTUBE_API_KEY=your_youtube_api_key_here
NEXT_PUBLIC_YOUTUBE_API_KEY=your_youtube_api_key_here

# YouTube OAuth 2.0 (Required only for live comment posting: scope 'https://www.googleapis.com/auth/youtube.force-ssl')
YOUTUBE_OAUTH_CLIENT_ID=your_oauth_client_id_here
YOUTUBE_OAUTH_CLIENT_SECRET=your_oauth_client_secret_here
YOUTUBE_OAUTH_ACCESS_TOKEN=your_oauth_access_token_here

# Google Places API (Required for live Tata STRIVE training center reviews)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Groq or xAI API Key (Required for AI News Intelligence & Campaign Studio)
GROQ_API_KEY=your_groq_api_key_here
XAI_API_KEY=your_xai_api_key_here

# Meta Graph API (Optional for Facebook / Instagram test token)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# Python Backend URL (Defaults to http://localhost:8000)
PYTHON_BACKEND_URL=http://localhost:8000
